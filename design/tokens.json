{
  "colors": {
    "bg": "#0a0a0f",
    "surface": "#18181f",
    "border": "#2a2a38",
    "accent-primary": "#7c6bff",
    "accent-secondary": "#00d4aa",
    "text-primary": "#e8e8f0",
    "text-muted": "#7070a0"
  },
  "typography": {
    "fonts": {
      "display": "Syne",
      "body": "DM Sans",
      "mono": "DM Mono"
    },
    "headline": {
      "fontFamily": "Syne",
      "fontSize": "clamp(40px, 7vw, 72px)",
      "fontWeight": 800,
      "lineHeight": 1.05,
      "letterSpacing": "-0.03em"
    },
    "body": {
      "fontFamily": "DM Sans",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "badge": {
      "fontFamily": "DM Mono",
      "fontSize": "12px",
      "fontWeight": 500,
      "letterSpacing": "0.1em",
      "textTransform": "uppercase"
    },
    "pill": {
      "fontFamily": "DM Mono",
      "fontSize": "13px",
      "fontWeight": 400
    },
    "button": {
      "fontFamily": "DM Sans",
      "fontSize": "16px",
      "fontWeight": 600
    }
  },
  "spacing": {
    "hero-padding-x": "80px",
    "content-max-width": "720px",
    "bio-max-width": "560px",
    "section-gap": "32px",
    "cta-gap": "16px",
    "pills-gap": "12px",
    "pills-margin-top": "40px"
  },
  "radii": {
    "badge": "9999px",
    "button": "10px",
    "pill": "8px"
  },
  "effects": {
    "glow-blob": {
      "color": "rgba(124, 107, 255, 0.08)",
      "radius": "400px",
      "blur": "120px",
      "offset": "top-right"
    }
  },
  "breakpoints": {
    "desktop": "1440px",
    "tablet": "768px",
    "mobile": "375px"
  },
  "animation": {
    "badge": { "type": "fade-in + slide-down", "delay": "0ms" },
    "headline-line1": { "type": "fade-in + slide-up 20px", "delay": "100ms" },
    "headline-line2": { "type": "fade-in + slide-up 20px", "delay": "200ms" },
    "bio": { "type": "fade-in", "delay": "350ms" },
    "cta-buttons": { "type": "fade-in + slide-up 10px", "delay": "500ms" },
    "tech-pills": { "type": "staggered fade-in", "stagger": "50ms", "startDelay": "650ms" }
  }
}
