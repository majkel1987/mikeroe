# Gmail SMTP (use Google App Password, NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where contact form emails are delivered
CONTACT_EMAIL_TO=your-public-contact@gmail.com

# Privacy-first analytics. Leave unset in local development to disable loading.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=mikeroe.pl
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
